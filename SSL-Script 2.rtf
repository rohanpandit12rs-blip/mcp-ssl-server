def get_cert_expiry_curl(domain_with_port):\
    """Curl use karke expiry date nikalta hai."""\
    domain = domain_with_port.split(':')[0].strip()\
    port = domain_with_port.split(':')[1].strip() if ':' in domain_with_port else "443"\
    \
    url = f"https://\{domain\}:\{port\}"\
    cmd = f"curl -k -v -s -I \{url\} 2>&1 | grep -i 'expire date'"\
    \
    try:\
        result = subprocess.run(cmd, shell=True, capture_output=True, text=True, timeout=10)\
        output = result.stdout.strip()\
        \
        if "expire date" in output.lower():\
            date_str = output.split('expire date:')[1].strip()\
            return date_str\
        else:\
            return "CHECK FAILED (No expiry info)"\
    except Exception as e:\
        return "CHECK FAILED (Error/Timeout)"\
\
def send_email():\
    """Updated Excel sheet ko attach karke email bhejta hai."""\
    print("Sending email notification...")\
    msg = EmailMessage()\
    msg['Subject'] = f"Weekly SSL Certificate Status - \{datetime.now().strftime('%Y-%m-%d')\}"\
    msg['From'] = EMAIL_SENDER\
    msg['To'] = EMAIL_RECEIVER\
    msg.set_content("Hello,\\n\\nPlease find the attached 'Hardware Support Details.xlsx' with the latest SSL Certificate expiry statuses.\\n\\nRegards,\\nAutomation Bot")\
    \
    # Updated file attach karna\
    with open(FILE_PATH, 'rb') as f:\
        file_data = f.read()\
    msg.add_attachment(file_data, maintype='application', subtype='vnd.openxmlformats-officedocument.spreadsheetml.sheet', filename=FILE_PATH)\
    \
    try:\
        with smtplib.SMTP_SSL('smtp.gmail.com', 465) as smtp:\
            smtp.login(EMAIL_SENDER, EMAIL_PASSWORD)\
            smtp.send_message(msg)\
        print("Email sent successfully!")\
    except Exception as e:\
        print(f"Email bhejne mein error aaya: \{e\}")\
\
def main():\
    print(f"Reading data from \{FILE_PATH\}...")\
    \
    # 1. Sheet read karna (Naye add kiye hue domains automatically aa jayenge)\
    df = pd.read_excel(FILE_PATH, sheet_name=SHEET_NAME)\
    \
    changes_made = False\
    \
    # 2. Har domain ko check karna\
    for index, row in df.iterrows():\
        domain = str(row['Name']).strip()\
        \
        # Check karna ki cell khali na ho aur valid domain ho\
        if domain != 'nan' and '.' in domain:\
            print(f"Checking \{domain\}...")\
            new_expiry = get_cert_expiry_curl(domain)\
            df.at[index, 'Expiry'] = new_expiry\
            changes_made = True\
            \
    # 3. Agar kuch update hua hai, toh Excel file mein wapas save karna\
    if changes_made:\
        print("Updating Excel sheet...")\
        # openpyxl engine baaki sheets (jaise Servers, Firewalls) ko delete hone se bachayega\
        with pd.ExcelWriter(FILE_PATH, engine='openpyxl', mode='a', if_sheet_exists='replace') as writer:\
            df.to_excel(writer, sheet_name=SHEET_NAME, index=False)\
        print("Excel update complete.")\
        \
        # 4. Email send karna\
        send_email()\
    else:\
        print("Koi valid domain check nahi hua.")\
